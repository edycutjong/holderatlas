# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (the only required configuration; ~100–130 credits per cold atlas, 0 on a cache hit)
NANSEN_API_KEY=nsn_your-key-here

# ── Optional ─────────────────────────────────────────────────
# SITE_URL=https://holderatlas.edycu.dev
# Spend guard on the public /api/atlas route (defaults shown; see apps/web/lib/guard.ts)
GUARD_IP_PER_MIN=4
GUARD_DAILY_CREDITS=3000
