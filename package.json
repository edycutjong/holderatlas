{
  "name": "holderatlas",
  "version": "1.4.1",
  "private": true,
  "description": "Type a token. See where its holders actually are — one world map from Nansen exchange entity labels, with the % attributable printed as large as the map.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "spike": "tsx scripts/spike.ts",
    "holderatlas": "tsx packages/cli/src/cli.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "tsx scripts/check_submission_readiness.ts",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yml,yaml}\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run verify && npm run check",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.26",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  }
}
